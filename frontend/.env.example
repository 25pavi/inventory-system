# ─────────────────────────────────────────────
#  Frontend Environment Variables — EXAMPLE FILE
#  Copy this file to .env and fill in your values.
#  NEVER commit your real .env file to GitHub.
#
#  Vite reads variables that start with VITE_
#  You can access them in code as: import.meta.env.VITE_API_URL
# ─────────────────────────────────────────────

# The full URL of your backend API.
# For local development:
VITE_API_URL=http://localhost:5000
# For production (after deploying to Render), use your Render URL:
# VITE_API_URL=https://your-backend-name.onrender.com
